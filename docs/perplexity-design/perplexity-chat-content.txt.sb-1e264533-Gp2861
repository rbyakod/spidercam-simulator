import React, { useEffect, useState } from "react";

export default function Dashboard() {
  const [state, setState] = useState<any>(null);
  const [ws, setWs] = useState<WebSocket | null>(null);

  useEffect(() => {
    const sock = new WebSocket("ws://raspberrypi.local:8000/ws");
    sock.onmessage = (e) => setState(JSON.parse(e.data));
    setWs(sock);
    return () => sock.close();
  }, []);

  const jog = (dx:number, dy:number, dz:number) => {
    ws?.send(JSON.stringify({ type: "jog", dx, dy, dz, speed: 0.1 }));
  };

  return (
    <div style={{padding: 24}}>
      <h1>SpiderPi Dashboard</h1>
      <pre>{JSON.stringify(state, null, 2)}</pre>
      <button onClick={() => jog(-0.05,0,0)}>Left</button>
      <button onClick={() => jog(0.05,0,0)}>Right</button>
      <button onClick={() => jog(0,-0.05,0)}>Forward</button>
      <button onClick={() => jog(0,0.05,0)}>Back</button>
      <button onClick={() => jog(0,0,-0.03)}>Up</button>
      <button onClick={() => jog(0,0,0.03)}>Down</button>
    </div>
  );
}
